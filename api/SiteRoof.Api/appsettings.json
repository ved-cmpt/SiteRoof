{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": true
  },
  "Spa": {
    "RootPath": "wwwroot"
  },
  "Demo": {
    "Enabled": true,
    "LifetimeHours": 8,
    "MaxActiveTenants": 300,
    "CleanupIntervalMinutes": 10,
    "ProvisionPermitsPerWindow": 6,
    "ProvisionWindowMinutes": 15
  },
  "Outbox": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 2,
    "BatchSize": 10,
    "MaxAttempts": 5,
    "BaseDelaySeconds": 5,
    "MaxDelaySeconds": 300
  },
  "Erp": {
    "BaseUrl": "http://localhost:5080",
    "TimeoutSeconds": 10
  },
  "RateLimits": {
    "ApiPermitsPerMinute": 600
  },
  "Insights": {
    "AiProvider": ""
  },
  "ForwardedHeaders": {
    "Enabled": false
  }
}
