# Copy to .env (never commit .env). Used by docker-compose.yml and scripts/.
# SQL Server SA password: 12+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd

# Connection string used by the API when running on the host (dotnet run).
ConnectionStrings__SiteRoof=Server=127.0.0.1,1434;Database=SiteRoof;User Id=sa;Password=ChangeMe_Str0ng!Passw0rd;TrustServerCertificate=True;Encrypt=True

# Optional: fixed key for the self-hosted mock ERP (random per process when unset).
# Erp__ApiKey=

# Optional: name of an AI summary provider. Leave empty to use the rules-based summary only.
# Insights__AiProvider=
